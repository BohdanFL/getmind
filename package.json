{
    "name": "getmind",
    "private": true,
    "scripts": {
        "dev": "concurrently --kill-others -n \"FE,BE\" -c \"blue,green\" \"pnpm run dev:fe\" \"pnpm run dev:be\"",
        "dev:fe": "cd frontend && pnpm dev",
        "dev:be": "cd backend && ..\\.venv\\Scripts\\python main.py",
        "kill": "taskkill /IM python.exe /F || exit 0",
        "clean-dev": "pnpm run kill && pnpm run dev"
    },
    "devDependencies": {
        "concurrently": "^9.2.1"
    }
}
